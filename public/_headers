/data/*
  Cache-Control: public, max-age=31536000, immutable

/js/chunks/*
  Cache-Control: public, max-age=31536000, immutable

/js/pages/*
  Cache-Control: no-cache

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' https://cdn.nba.com; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'
